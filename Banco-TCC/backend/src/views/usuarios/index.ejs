<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="dashboard-container">
    <header class="painel-header">
        <div class="header-title-col">
            <h1>Gestão de Usuários</h1>
            <p>Controle de Administradores, Professores e Alunos Matriculados</p>
        </div>

        <div class="header-meta-col">
            <% if (isOwner) { %>
                <span class="badge-cargo owner">Proprietário (Owner)</span>
            <% } else { %>
                <span class="badge-cargo admin">Administrador</span>
            <% } %>
        </div>
    </header>

    <!-- Tabs para alternar entre Administradores, Professores e Alunos -->
    <div style="display: flex; gap: 10px; border-bottom: 2px solid var(--border-color); padding-bottom: 12px; flex-wrap: wrap;">
        <button type="button" class="tab-btn ativo" id="tabBtnAlunos" onclick="trocarAbaUsuarios('alunos', true)">
            Alunos Matriculados <span class="tab-badge"><%= alunos.length %></span>
        </button>
        <button type="button" class="tab-btn" id="tabBtnProfessores" onclick="trocarAbaUsuarios('professores', true)">
            Professores <span class="tab-badge"><%= professores.length %></span>
        </button>
        <button type="button" class="tab-btn" id="tabBtnAdmins" onclick="trocarAbaUsuarios('admins', true)">
            Administradores <span class="tab-badge"><%= administradores.length %></span>
        </button>
    </div>

    <!-- 1. TABELA DE ALUNOS -->
    <section class="mensalidades-card" id="secaoAlunos">
        <div class="secao-header">
            <h2>Lista de Alunos</h2>
            <span style="font-size: 13px; color: var(--text-muted);">
                <%= isOwner ? 'Você pode atribuir descontos individuais (%) e validar pagamentos.' : 'Você pode verificar comprovantes e consultar históricos de mensalidade.' %>
            </span>
        </div>

        <div class="tabela-container">
            <table class="tabela-mensalidades">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Cursos</th>
                        <th>Mensalidade Base</th>
                        <th>Desconto</th>
                        <th>Valor Final</th>
                        <th>Status Atual</th>
                        <th>Comprovante</th>
                        <th style="text-align: right;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% alunos.forEach(function(al) { %>
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div class="aniv-avatar" style="width: 32px; height: 32px; font-size: 12px;">
                                        <%= al.nome.charAt(0) %>
                                    </div>
                                    <div>
                                        <strong style="color: var(--text-primary);"><%= al.nome %></strong>
                                        <div style="font-size: 11px; color: var(--text-muted);"><%= al.email %> • <%= al.telefone || "Sem telefone" %></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                    <% (al.curso || 'Piano').split(',').map(c => c.trim()).filter(Boolean).forEach(function(cur) { %>
                                        <span class="badge-curso"><%= cur %></span>
                                    <% }); %>
                                </div>
                            </td>
                            <td>
                                R$ <%= Number(al.valor_base).toFixed(2) %>
                            </td>
                            <td>
                                <% if (Number(al.desconto_porcentagem) > 0) { %>
                                    <span style="background: #fef3c7; color: #92400e; padding: 2px 7px; border-radius: 6px; font-weight: 700; font-size: 11.5px;">
                                        <%= al.desconto_porcentagem %>% OFF
                                    </span>
                                <% } else { %>
                                    <span style="color: var(--text-muted); font-size: 12px;">Sem desconto</span>
                                <% } %>
                            </td>
                            <td>
                                <strong style="color: var(--accent-gold); font-size: 14px;">
                                    R$ <%= Number(al.valor_cobrado).toFixed(2) %>
                                </strong>
                            </td>
                            <td>
                                <% if (al.status_mes_atual === 'pago') { %>
                                    <span class="status-pill pago">● Pago</span>
                                <% } else if (al.status_mes_atual === 'em_analise') { %>
                                    <span class="status-pill em_analise">Em Análise</span>
                                <% } else if (al.status_mes_atual === 'atrasado') { %>
                                    <span class="status-pill atrasado">Vencido</span>
                                <% } else { %>
                                    <span class="status-pill pendente">Pendente</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (al.comprovante_url) { %>
                                    <a href="<%= al.comprovante_url %>" target="_blank" class="link-ver-comprovante" title="Ver Comprovante enviado">
                                        Ver Anexo
                                    </a>
                                <% } else { %>
                                    <span style="color: var(--text-muted); font-size: 12px;">Nenhum anexo</span>
                                <% } %>
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end;">
                                    <% if (al.status_mes_atual === 'em_analise' && al.id_recebimento_atual) { %>
                                        <button type="button" class="btn-acao-comprovante btn-validar-alerta" 
                                            onclick="abrirModalValidacao('<%= al.id_recebimento_atual %>', '<%= al.nome %>', '<%= Number(al.valor_cobrado).toFixed(2) %>', '<%= al.comprovante_url %>')">
                                            Validar
                                        </button>
                                    <% } %>

                                    <% if (isOwner) { %>
                                        <button type="button" class="btn-acao-editar" 
                                            onclick="abrirModalEditarUsuario({ id_usuario: '<%= al.id_usuario %>', idaluno: '<%= al.idaluno %>', nome: '<%= al.nome %>', email: '<%= al.email %>', telefone: '<%= al.telefone || '' %>', cpf: '<%= al.cpf || '' %>', data_nascimento: '<%= al.data_nascimento ? new Date(al.data_nascimento).toISOString().split('T')[0] : '' %>', tipo: 'normal', cursos: '<%= al.curso || 'Piano' %>', desconto: '<%= al.desconto_porcentagem || 0 %>' })"
                                            title="Editar Dados Cadastrais do Aluno">
                                            Editar
                                        </button>
                                        <button type="button" class="btn-acao-comprovante" 
                                            onclick="abrirModalCurso('<%= al.idaluno %>', '<%= al.nome %>', '<%= al.curso || 'Piano' %>')"
                                            title="Editar Cursos / Matrícula do Aluno">
                                            Cursos
                                        </button>
                                        <button type="button" class="btn-acao-comprovante" 
                                            onclick="abrirModalDesconto('<%= al.idaluno %>', '<%= al.nome %>', '<%= al.desconto_porcentagem %>')"
                                            title="Atribuir Desconto Individual">
                                            Desconto
                                        </button>
                                        <button type="button" class="btn-acao-excluir" 
                                            onclick="abrirConfirmarExclusao('<%= al.id_usuario %>', '<%= al.nome %>', 'Aluno')"
                                            title="Excluir Conta do Aluno">
                                            Excluir
                                        </button>
                                    <% } %>

                                    <button type="button" class="btn-acao-comprovante" 
                                        onclick="abrirHistoricoAluno('<%= al.idaluno %>', '<%= al.nome %>')"
                                        title="Ver histórico de mensalidades de meses anteriores">
                                        Histórico
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </section>

    <!-- 2. TABELA DE PROFESSORES -->
    <section class="mensalidades-card oculto" id="secaoProfessores">
        <div class="secao-header">
            <h2>Corpo Docente (Professores)</h2>
            <span style="font-size: 13px; color: var(--text-muted);"><%= professores.length %> professores cadastrados</span>
        </div>

        <div class="tabela-container">
            <table class="tabela-mensalidades">
                <thead>
                    <tr>
                        <th>Professor</th>
                        <th>E-mail</th>
                        <th>Telefone</th>
                        <th>Especialidades / Instrumentos</th>
                        <th>Data de Cadastro</th>
                        <% if (isOwner) { %>
                            <th style="text-align: right;">Ações</th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% professores.forEach(function(p) { %>
                        <tr>
                            <td>
                                <strong style="color: var(--text-primary);"><%= p.nome %></strong>
                                <% if (p.descricao) { %>
                                    <div style="font-size: 11px; color: var(--text-muted);"><%= p.descricao %></div>
                                <% } %>
                            </td>
                            <td><%= p.email %></td>
                            <td><%= p.telefone || "—" %></td>
                            <td>
                                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                    <% (p.tipo_instrumento || 'Geral').split(',').map(e => e.trim()).filter(Boolean).forEach(function(esp) { %>
                                        <span class="badge-especialidade"><%= esp %></span>
                                    <% }); %>
                                </div>
                            </td>
                            <td><%= new Date(p.data_cadastro).toLocaleDateString('pt-BR') %></td>
                            <% if (isOwner) { %>
                                <td style="text-align: right;">
                                    <div style="display: inline-flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end;">
                                        <button type="button" class="btn-acao-editar" 
                                            onclick="abrirModalEditarUsuario({ id_usuario: '<%= p.id_usuario %>', idprofessor: '<%= p.idprofessor %>', nome: '<%= p.nome %>', email: '<%= p.email %>', telefone: '<%= p.telefone || '' %>', cpf: '<%= p.cpf || '' %>', tipo: 'professor', especialidades: '<%= p.tipo_instrumento || 'Piano' %>' })"
                                            title="Editar Dados Cadastrais do Professor">
                                            Editar
                                        </button>
                                        <button type="button" class="btn-acao-comprovante" 
                                            onclick="abrirModalEspecialidade('<%= p.idprofessor || p.id_usuario %>', '<%= p.nome %>', '<%= p.tipo_instrumento || 'Piano' %>')"
                                            title="Editar Especialidades do Professor">
                                            Especialidades
                                        </button>
                                        <button type="button" class="btn-acao-excluir" 
                                            onclick="abrirConfirmarExclusao('<%= p.id_usuario %>', '<%= p.nome %>', 'Professor')"
                                            title="Excluir Conta do Professor">
                                            Excluir
                                        </button>
                                    </div>
                                </td>
                            <% } %>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </section>

    <!-- 3. TABELA DE ADMINISTRADORES -->
    <section class="mensalidades-card oculto" id="secaoAdmins">
        <div class="secao-header">
            <h2>Equipe Administrativa</h2>
            <span style="font-size: 13px; color: var(--text-muted);"><%= administradores.length %> gestores cadastrados</span>
        </div>

        <div class="tabela-container">
            <table class="tabela-mensalidades">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Telefone</th>
                        <th>CPF</th>
                        <th>Cargo</th>
                        <th>Cadastro</th>
                        <% if (isOwner) { %>
                            <th style="text-align: right;">Ações</th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% administradores.forEach(function(adm) { %>
                        <tr>
                            <td>
                                <strong style="color: var(--text-primary);"><%= adm.nome %></strong>
                                <% if (adm.descricao) { %>
                                    <div style="font-size: 11px; color: var(--text-muted);"><%= adm.descricao %></div>
                                <% } %>
                            </td>
                            <td><%= adm.email %></td>
                            <td><%= adm.telefone || "—" %></td>
                            <td><%= adm.cpf || "—" %></td>
                            <td>
                                <% if (adm.tipo_usuario === 'owner') { %>
                                    <span style="background: #0f172a; color: #ffffff; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-size: 12px;">
                                        Owner (Proprietário)
                                    </span>
                                <% } else { %>
                                    <span style="background: #fef3c7; color: #92400e; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-size: 12px;">
                                        Administrador
                                    </span>
                                <% } %>
                            </td>
                            <td><%= new Date(adm.data_cadastro).toLocaleDateString('pt-BR') %></td>
                            <% if (isOwner) { %>
                                <td style="text-align: right;">
                                    <% if (adm.id_usuario != usuario.id_usuario && adm.tipo_usuario !== 'owner') { %>
                                        <div style="display: inline-flex; gap: 6px; justify-content: flex-end;">
                                            <button type="button" class="btn-acao-editar" 
                                                onclick="abrirModalEditarUsuario({ id_usuario: '<%= adm.id_usuario %>', nome: '<%= adm.nome %>', email: '<%= adm.email %>', telefone: '<%= adm.telefone || '' %>', cpf: '<%= adm.cpf || '' %>', tipo: '<%= adm.tipo_usuario %>' })"
                                                title="Editar Dados do Administrador">
                                                Editar
                                            </button>
                                            <button type="button" class="btn-acao-excluir" 
                                                onclick="abrirConfirmarExclusao('<%= adm.id_usuario %>', '<%= adm.nome %>', 'Administrador')"
                                                title="Excluir Conta de Administrador">
                                                Excluir
                                            </button>
                                        </div>
                                    <% } else { %>
                                        <span style="font-size: 11px; color: var(--text-muted);">Sua Conta</span>
                                    <% } %>
                                </td>
                            <% } %>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </section>
</main>

<!-- MODAL DE ATRIBUIÇÃO DE DESCONTO (EXCLUSIVO OWNER) -->
<div id="modalDescontoOwner" class="modal-overlay oculto">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Atribuir Desconto de Aluno</h3>
            <button type="button" class="btn-fechar-modal" onclick="fecharModalDesconto()">&times;</button>
        </div>

        <form id="formAtribuirDesconto">
            <input type="hidden" id="modalDescontoIdAluno">

            <div class="form-grupo">
                <label>Aluno</label>
                <input type="text" id="modalDescontoNomeAluno" disabled style="opacity: 0.8; cursor: not-allowed;">
            </div>

            <div class="form-grupo">
                <label for="modalDescontoPorcentagem">Porcentagem de Desconto (%)</label>
                <div style="display: flex; gap: 8px;">
                    <input type="number" id="modalDescontoPorcentagem" min="0" max="100" step="5" required style="font-size: 16px; font-weight: 700;">
                    <span style="display: flex; align-items: center; font-weight: 700; color: var(--text-secondary);">%</span>
                </div>
                <small style="color: var(--text-muted); font-size: 11.5px;">
                    Ex: 10% para desconto familiar, 50% meia bolsa ou 100% bolsa integral.
                </small>
            </div>

            <button type="submit" id="btnSalvarDesconto" class="btn-confirmar-pagamento">
                Salvar Desconto
            </button>
        </form>
    </div>
</div>

<% 
    const todasEspecialidades = [
        'Piano', 'Violino', 'Violoncelo', 'Viola de Arco', 'Contrabaixo Acústico',
        'Flauta Transversal', 'Saxofone', 'Clarinete', 'Trompete', 'Bateria Acústica',
        'Violão Acústico', 'Canto', 'Teoria Musical'
    ];
    if (locals.instrumentos) {
        instrumentos.forEach(ins => {
            if (!todasEspecialidades.includes(ins.nome)) todasEspecialidades.push(ins.nome);
        });
    }
%>

<!-- MODAL PARA O OWNER MUDAR O CURSO DO ALUNO (MÚLTIPLOS CURSOS) -->
<div id="modalEditarCursoAluno" class="modal-overlay oculto">
    <div class="modal-card" style="max-width: 520px;">
        <div class="modal-header">
            <h3>Alterar Cursos do Aluno</h3>
            <button type="button" class="btn-fechar-modal" onclick="fecharModalCurso()">&times;</button>
        </div>

        <form id="formMudarCursoAluno">
            <input type="hidden" id="cursoModalIdAluno">

            <div class="form-grupo">
                <label>Aluno</label>
                <input type="text" id="cursoModalNomeAluno" disabled style="opacity: 0.85; cursor: not-allowed; font-weight: 700;">
            </div>

            <div class="form-grupo">
                <label>Cursos Matriculados (Selecione 1 ou mais)</label>
                <div class="chips-grid" id="containerCursosAlunoModal">
                    <% cursos.forEach(function(c) { %>
                        <label class="tag-check-chip" id="chip_curso_<%= c.nome.replace(/\s+/g, '_') %>">
                            <input type="checkbox" name="cursosAlunoModal" value="<%= c.nome %>">
                            <span><%= c.nome %></span>
                        </label>
                    <% }); %>
                </div>
                <small style="color: var(--text-muted); font-size: 11.5px;">
                    O aluno pode cursar mais de um instrumento. As mensalidades base serão somadas e o desconto aplicado sobre o valor total.
                </small>
            </div>

            <button type="submit" id="btnSalvarCursoAluno" class="btn-confirmar-pagamento">
                Salvar Cursos
            </button>
        </form>
    </div>
</div>

<!-- MODAL PARA O OWNER MUDAR AS ESPECIALIDADES DO PROFESSOR (MÚLTIPLAS ESPECIALIDADES) -->
<div id="modalEditarEspecialidadeProfessor" class="modal-overlay oculto">
    <div class="modal-card" style="max-width: 520px;">
        <div class="modal-header">
            <h3>Alterar Especialidades do Professor</h3>
            <button type="button" class="btn-fechar-modal" onclick="fecharModalEspecialidade()">&times;</button>
        </div>

        <form id="formMudarEspecialidadeProfessor">
            <input type="hidden" id="espModalIdProfessor">

            <div class="form-grupo">
                <label>Professor</label>
                <input type="text" id="espModalNomeProfessor" disabled style="opacity: 0.85; cursor: not-allowed; font-weight: 700;">
            </div>

            <div class="form-grupo">
                <label>Especialidades / Instrumentos (Selecione 1 ou mais)</label>
                <div class="chips-grid" id="containerEspecialidadesProfModal">
                    <% todasEspecialidades.forEach(function(esp) { %>
                        <label class="tag-check-chip" id="chip_esp_<%= esp.replace(/\s+/g, '_') %>">
                            <input type="checkbox" name="especialidadesProfModal" value="<%= esp %>">
                            <span><%= esp %></span>
                        </label>
                    <% }); %>
                </div>
                <small style="color: var(--text-muted); font-size: 11.5px;">
                    O professor pode lecionar mais de um instrumento no Instituto Musical Bravo Tatuí.
                </small>
            </div>

            <button type="submit" id="btnSalvarEspecialidade" class="btn-confirmar-pagamento">
                Salvar Especialidades
            </button>
        </form>
    </div>
</div>

<!-- MODAL COMPLETO DE EDIÇÃO DE DADOS DE USUÁRIO (OWNER / ADMIN) -->
<div id="modalEditarUsuarioCompleto" class="modal-overlay oculto">
    <div class="modal-card" style="max-width: 540px; width: 92%;">
        <div class="modal-header">
            <h3>Editar Dados do Usuário</h3>
            <button type="button" class="btn-fechar-modal" onclick="fecharModalEditarUsuario()">&times;</button>
        </div>

        <form id="formEditarUsuarioCompleto">
            <input type="hidden" id="editModalIdUsuario">
            <input type="hidden" id="editModalIdAluno">
            <input type="hidden" id="editModalIdProfessor">

            <div class="form-grupo">
                <label for="editModalNome">Nome Completo</label>
                <input type="text" id="editModalNome" required>
            </div>

            <div class="form-grupo">
                <label for="editModalEmail">E-mail</label>
                <input type="email" id="editModalEmail" required>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-grupo">
                    <label for="editModalCPF">CPF</label>
                    <input type="text" id="editModalCPF" placeholder="000.000.000-00">
                </div>
                <div class="form-grupo">
                    <label for="editModalTelefone">Telefone / Celular</label>
                    <input type="text" id="editModalTelefone" placeholder="(15) 99999-0000">
                </div>
            </div>

            <% if (isOwner) { %>
                <div class="form-grupo">
                    <label for="editModalTipoUsuario">Cargo / Nível de Acesso (Exclusivo Owner)</label>
                    <select id="editModalTipoUsuario" onchange="alternarCamposEdicao(this.value)">
                        <option value="normal">Aluno (Normal)</option>
                        <option value="professor">Professor</option>
                        <option value="admin">Administrador</option>
                    </select>
                </div>
            <% } else { %>
                <input type="hidden" id="editModalTipoUsuario" value="normal">
            <% } %>

            <!-- Seção Aluno -->
            <div id="editSecaoAluno">
                <div class="form-grupo">
                    <label for="editModalDataNasc">Data de Nascimento (Aluno)</label>
                    <input type="date" id="editModalDataNasc">
                </div>

                <div class="form-grupo">
                    <label>Cursos Matriculados (Selecione 1 ou mais)</label>
                    <div class="chips-grid" id="editGridCursosAluno">
                        <% cursos.forEach(function(c) { %>
                            <label class="tag-check-chip" id="edit_chip_curso_<%= c.nome.replace(/\s+/g, '_') %>">
                                <input type="checkbox" name="editCursosAluno" value="<%= c.nome %>">
                                <span><%= c.nome %></span>
                            </label>
                        <% }); %>
                    </div>
                </div>

                <% if (isOwner) { %>
                    <div class="form-grupo">
                        <label for="editModalDesconto">Desconto Atribuído (%)</label>
                        <div style="display: flex; gap: 8px;">
                            <input type="number" id="editModalDesconto" min="0" max="100" step="5" style="font-weight: 700;">
                            <span style="display: flex; align-items: center; font-weight: 700; color: var(--text-secondary);">%</span>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Seção Professor -->
            <div id="editSecaoProfessor" style="display: none;">
                <div class="form-grupo">
                    <label>Especialidades / Instrumentos (Selecione 1 ou mais)</label>
                    <div class="chips-grid" id="editGridEspecialidadesProf">
                        <% todasEspecialidades.forEach(function(esp) { %>
                            <label class="tag-check-chip" id="edit_chip_esp_<%= esp.replace(/\s+/g, '_') %>">
                                <input type="checkbox" name="editEspecialidadesProf" value="<%= esp %>">
                                <span><%= esp %></span>
                            </label>
                        <% }); %>
                    </div>
                </div>
            </div>

            <button type="submit" id="btnSalvarEdicaoCompleta" class="btn-confirmar-pagamento">
                Salvar Alterações
            </button>
        </form>
    </div>
</div>

<!-- MODAL DE CONFIRMAÇÃO DE EXCLUSÃO (EXCLUSIVO OWNER) -->
<div id="modalConfirmarExclusao" class="modal-overlay oculto">
    <div class="modal-card" style="max-width: 440px;">
        <div class="modal-header">
            <h3 style="color: #ef4444;">Excluir Usuário</h3>
            <button type="button" class="btn-fechar-modal" onclick="fecharConfirmarExclusao()">&times;</button>
        </div>

        <div>
            <p style="font-size: 14px; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.5;">
                Tem certeza que deseja excluir permanentemente o usuário <strong id="excluirNomeUsuario" style="color: #ffffff;"></strong> (<span id="excluirTipoUsuario"></span>)?
            </p>
            <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 12px; margin-bottom: 16px;">
                <p style="font-size: 12px; color: #fca5a5; margin: 0;">
                    ⚠️ Atenção: Esta ação removerá o login, matrículas, registros financeiros e histórico associados. Não poderá ser desfeita.
                </p>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-acao-comprovante" onclick="fecharConfirmarExclusao()" style="padding: 9px 16px;">
                    Cancelar
                </button>
                <button type="button" id="btnConfirmarExclusaoDefinitiva" onclick="executarExclusaoUsuario()" class="btn-acao-excluir" style="padding: 9px 18px; font-size: 13px;">
                    Confirmar Exclusão
                </button>
            </div>
        </div>
    </div>
</div>

