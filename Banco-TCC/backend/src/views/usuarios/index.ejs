<script>
    function trocarAbaUsuarios(aba, rolar = true) {
        const secoes = {
            'alunos': { el: document.getElementById('secaoAlunos'), btn: document.getElementById('tabBtnAlunos') },
            'professores': { el: document.getElementById('secaoProfessores'), btn: document.getElementById('tabBtnProfessores') },
            'admins': { el: document.getElementById('secaoAdmins'), btn: document.getElementById('tabBtnAdmins') }
        };

        if (!secoes[aba]) aba = 'alunos';

        Object.keys(secoes).forEach(chave => {
            const item = secoes[chave];
            const ativo = (chave === aba);
            if (item.el) {
                item.el.classList.toggle('oculto', !ativo);
            }
            if (item.btn) {
                item.btn.classList.toggle('ativo', ativo);
            }
        });

        // Atualiza a URL com a âncora correspondente sem reload
        if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', '#' + aba);
        }

        // Rola suavemente até a seção correspondente
        if (rolar && secoes[aba] && secoes[aba].el) {
            secoes[aba].el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    // Inicialização automática a partir do hash da URL (#alunos, #professores, #admins)
    (function verificarHashInicial() {
        const hash = (window.location.hash || '').replace('#', '').toLowerCase();
        if (['alunos', 'professores', 'admins'].includes(hash)) {
            trocarAbaUsuarios(hash, false);
        }
    })();

    window.addEventListener('hashchange', function() {
        const hash = (window.location.hash || '').replace('#', '').toLowerCase();
        if (['alunos', 'professores', 'admins'].includes(hash)) {
            trocarAbaUsuarios(hash, true);
        }
    });

    // Modal Desconto
    function abrirModalDesconto(id, nome, descontoAtual) {
        document.getElementById('modalDescontoIdAluno').value = id;
        document.getElementById('modalDescontoNomeAluno').value = nome;
        document.getElementById('modalDescontoPorcentagem').value = parseFloat(descontoAtual) || 0;
        document.getElementById('modalDescontoOwner').classList.remove('oculto');
    }

    function fecharModalDesconto() {
        document.getElementById('modalDescontoOwner').classList.add('oculto');
    }

    document.getElementById('formAtribuirDesconto').addEventListener('submit', async function(e) {
        e.preventDefault();
        const id = document.getElementById('modalDescontoIdAluno').value;
        const desconto = document.getElementById('modalDescontoPorcentagem').value;
        const btn = document.getElementById('btnSalvarDesconto');
        const token = localStorage.getItem('authToken');

        btn.disabled = true;
        btn.textContent = 'Aplicando desconto...';

        try {
            const resp = await fetch(`/paginas/usuarios/aluno/${id}/desconto`, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    ...(token ? { Authorization: 'Bearer ' + token } : {})
                },
                body: JSON.stringify({ desconto }),
            });
            const dados = await resp.json();

            if (dados.sucesso) {
                alert('✓ ' + dados.mensagem);
                window.location.reload();
            } else {
                alert('Erro: ' + (dados.mensagem || 'Falha ao salvar desconto.'));
            }
        } catch (err) {
            alert('Erro de conexão ao salvar desconto.');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Salvar Desconto';
        }
    });

    // Modal Mudar Curso do Aluno (Owner) - Multi-cursos
    function abrirModalCurso(id, nome, cursosStr) {
        document.getElementById('cursoModalIdAluno').value = id;
        document.getElementById('cursoModalNomeAluno').value = nome;
        
        const listaCursos = (cursosStr || '')
            .split(',')
            .map(c => c.trim().toLowerCase())
            .filter(Boolean);

        document.querySelectorAll('input[name="cursosAlunoModal"]').forEach(cb => {
            const marcado = listaCursos.includes(cb.value.trim().toLowerCase());
            cb.checked = marcado;
            const label = cb.closest('.tag-check-chip');
            if (label) label.classList.toggle('ativo', marcado);
        });

        document.getElementById('modalEditarCursoAluno').classList.remove('oculto');
    }

    function fecharModalCurso() {
        document.getElementById('modalEditarCursoAluno').classList.add('oculto');
    }

    const formCursoAluno = document.getElementById('formMudarCursoAluno');
    if (formCursoAluno) {
        formCursoAluno.addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('cursoModalIdAluno').value;
            const selecionados = Array.from(document.querySelectorAll('input[name="cursosAlunoModal"]:checked'))
                .map(cb => cb.value.trim());

            if (selecionados.length === 0) {
                alert('Selecione ao menos um curso para o aluno.');
                return;
            }

            const btn = document.getElementById('btnSalvarCursoAluno');
            const token = localStorage.getItem('authToken');

            btn.disabled = true;
            btn.textContent = 'Salvando cursos...';

            try {
                const resp = await fetch(`/paginas/usuarios/aluno/${id}/curso`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        ...(token ? { Authorization: 'Bearer ' + token } : {})
                    },
                    body: JSON.stringify({ cursos: selecionados }),
                });
                const dados = await resp.json();

                if (dados.sucesso) {
                    alert('✓ ' + dados.mensagem);
                    window.location.reload();
                } else {
                    alert('Erro: ' + (dados.mensagem || 'Falha ao alterar cursos do aluno.'));
                }
            } catch (err) {
                alert('Erro de conexão ao salvar cursos.');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Salvar Cursos';
            }
        });
    }

    // Modal Mudar Especialidade do Professor (Owner) - Multi-especialidades
    function abrirModalEspecialidade(id, nome, espStr) {
        document.getElementById('espModalIdProfessor').value = id;
        document.getElementById('espModalNomeProfessor').value = nome;

        const listaEsp = (espStr || '')
            .split(',')
            .map(e => e.trim().toLowerCase())
            .filter(Boolean);

        document.querySelectorAll('input[name="especialidadesProfModal"]').forEach(cb => {
            const marcado = listaEsp.includes(cb.value.trim().toLowerCase());
            cb.checked = marcado;
            const label = cb.closest('.tag-check-chip');
            if (label) label.classList.toggle('ativo', marcado);
        });

        document.getElementById('modalEditarEspecialidadeProfessor').classList.remove('oculto');
    }

    function fecharModalEspecialidade() {
        document.getElementById('modalEditarEspecialidadeProfessor').classList.add('oculto');
    }

    const formEspProfessor = document.getElementById('formMudarEspecialidadeProfessor');
    if (formEspProfessor) {
        formEspProfessor.addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('espModalIdProfessor').value;
            const selecionados = Array.from(document.querySelectorAll('input[name="especialidadesProfModal"]:checked'))
                .map(cb => cb.value.trim());

            if (selecionados.length === 0) {
                alert('Selecione ao menos uma especialidade para o professor.');
                return;
            }

            const btn = document.getElementById('btnSalvarEspecialidade');
            const token = localStorage.getItem('authToken');

            btn.disabled = true;
            btn.textContent = 'Salvando especialidades...';

            try {
                const resp = await fetch(`/paginas/usuarios/professor/${id}/especialidade`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        ...(token ? { Authorization: 'Bearer ' + token } : {})
                    },
                    body: JSON.stringify({ especialidades: selecionados }),
                });
                const dados = await resp.json();

                if (dados.sucesso) {
                    alert('✓ ' + dados.mensagem);
                    window.location.reload();
                } else {
                    alert('Erro: ' + (dados.mensagem || 'Falha ao alterar especialidades.'));
                }
            } catch (err) {
                alert('Erro de conexão ao salvar especialidades.');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Salvar Especialidades';
            }
        });
    }

    // Alternar campos conforme o tipo de usuário no modal de edição completa
    function alternarCamposEdicao(tipo) {
        const secaoAluno = document.getElementById('editSecaoAluno');
        const secaoProf = document.getElementById('editSecaoProfessor');
        if (secaoAluno) {
            secaoAluno.style.display = (tipo === 'normal' || tipo === 'aluno') ? 'block' : 'none';
        }
        if (secaoProf) {
            secaoProf.style.display = (tipo === 'professor') ? 'block' : 'none';
        }
    }

    // Modal Completo de Edição de Usuário (Owner e Admin)
    function abrirModalEditarUsuario(dados) {
        if (!dados) return;

        document.getElementById('editModalIdUsuario').value = dados.id_usuario || '';
        document.getElementById('editModalIdAluno').value = dados.idaluno || '';
        document.getElementById('editModalIdProfessor').value = dados.idprofessor || '';
        document.getElementById('editModalNome').value = dados.nome || '';
        document.getElementById('editModalEmail').value = dados.email || '';
        document.getElementById('editModalCPF').value = dados.cpf || '';
        document.getElementById('editModalTelefone').value = dados.telefone || '';

        const selectTipo = document.getElementById('editModalTipoUsuario');
        const tipoFinal = (dados.tipo === 'aluno' || dados.tipo === 'normal') ? 'normal' : dados.tipo;
        if (selectTipo) {
            selectTipo.value = tipoFinal;
        }

        alternarCamposEdicao(tipoFinal);

        // Se for aluno
        const campoDataNasc = document.getElementById('editModalDataNasc');
        if (campoDataNasc) {
            campoDataNasc.value = dados.data_nascimento || '';
        }
        const campoDesconto = document.getElementById('editModalDesconto');
        if (campoDesconto) {
            campoDesconto.value = parseFloat(dados.desconto) || 0;
        }

        const listaCursos = (dados.cursos || '')
            .split(',')
            .map(c => c.trim().toLowerCase())
            .filter(Boolean);

        document.querySelectorAll('input[name="editCursosAluno"]').forEach(cb => {
            const marcado = listaCursos.includes(cb.value.trim().toLowerCase());
            cb.checked = marcado;
            const label = cb.closest('.tag-check-chip');
            if (label) label.classList.toggle('ativo', marcado);
        });

        // Se for professor
        const listaEsp = (dados.especialidades || '')
            .split(',')
            .map(e => e.trim().toLowerCase())
            .filter(Boolean);

        document.querySelectorAll('input[name="editEspecialidadesProf"]').forEach(cb => {
            const marcado = listaEsp.includes(cb.value.trim().toLowerCase());
            cb.checked = marcado;
            const label = cb.closest('.tag-check-chip');
            if (label) label.classList.toggle('ativo', marcado);
        });

        document.getElementById('modalEditarUsuarioCompleto').classList.remove('oculto');
    }

    function fecharModalEditarUsuario() {
        document.getElementById('modalEditarUsuarioCompleto').classList.add('oculto');
    }

    const formEditarCompleto = document.getElementById('formEditarUsuarioCompleto');
    if (formEditarCompleto) {
        formEditarCompleto.addEventListener('submit', async function(e) {
            e.preventDefault();
            const idUsuario = document.getElementById('editModalIdUsuario').value;
            const selectTipo = document.getElementById('editModalTipoUsuario');
            const tipo = selectTipo ? selectTipo.value : 'normal';
            const nome = document.getElementById('editModalNome').value.trim();
            const email = document.getElementById('editModalEmail').value.trim();
            const cpf = document.getElementById('editModalCPF').value.trim();
            const telefone = document.getElementById('editModalTelefone').value.trim();

            const payload = {
                nome,
                email,
                cpf,
                telefone,
                tipo_usuario: tipo
            };

            if (tipo === 'normal' || tipo === 'aluno') {
                const dataNasc = document.getElementById('editModalDataNasc') ? document.getElementById('editModalDataNasc').value : '';
                const desc = document.getElementById('editModalDesconto') ? document.getElementById('editModalDesconto').value : '';
                const cursos = Array.from(document.querySelectorAll('input[name="editCursosAluno"]:checked')).map(cb => cb.value.trim());

                if (cursos.length === 0) {
                    alert('Selecione ao menos um curso para o aluno.');
                    return;
                }
                payload.data_nascimento = dataNasc;
                payload.desconto_porcentagem = desc;
                payload.cursos = cursos;
            } else if (tipo === 'professor') {
                const especialidades = Array.from(document.querySelectorAll('input[name="editEspecialidadesProf"]:checked')).map(cb => cb.value.trim());
                if (especialidades.length === 0) {
                    alert('Selecione ao menos uma especialidade para o professor.');
                    return;
                }
                payload.especialidades = especialidades;
            }

            const btn = document.getElementById('btnSalvarEdicaoCompleta');
            const token = localStorage.getItem('authToken');
            btn.disabled = true;
            btn.textContent = 'Salvando alterações...';

            try {
                const resp = await fetch(`/paginas/usuarios/${idUsuario}/editar`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        ...(token ? { Authorization: 'Bearer ' + token } : {})
                    },
                    body: JSON.stringify(payload)
                });
                const res = await resp.json();

                if (res.sucesso) {
                    alert('✓ ' + res.mensagem);
                    window.location.reload();
                } else {
                    alert('Erro: ' + (res.mensagem || 'Falha ao salvar edições do usuário.'));
                }
            } catch (err) {
                alert('Erro de conexão ao salvar edições do usuário.');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Salvar Alterações';
            }
        });
    }

    // Modal de Confirmação de Exclusão (Exclusivo Owner)
    let idUsuarioParaExcluir = null;

    function abrirConfirmarExclusao(id, nome, tipo) {
        idUsuarioParaExcluir = id;
        document.getElementById('excluirNomeUsuario').textContent = nome;
        document.getElementById('excluirTipoUsuario').textContent = tipo;
        document.getElementById('modalConfirmarExclusao').classList.remove('oculto');
    }

    function fecharConfirmarExclusao() {
        document.getElementById('modalConfirmarExclusao').classList.add('oculto');
        idUsuarioParaExcluir = null;
    }

    async function executarExclusaoUsuario() {
        if (!idUsuarioParaExcluir) return;

        const btn = document.getElementById('btnConfirmarExclusaoDefinitiva');
        const token = localStorage.getItem('authToken');

        btn.disabled = true;
        btn.textContent = 'Excluindo conta...';

        try {
            const resp = await fetch(`/paginas/usuarios/${idUsuarioParaExcluir}/excluir`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token ? { Authorization: 'Bearer ' + token } : {})
                }
            });
            const dados = await resp.json();

            if (dados.sucesso) {
                alert('✓ ' + dados.mensagem);
                window.location.reload();
            } else {
                alert('Erro: ' + (dados.mensagem || 'Falha ao excluir usuário.'));
            }
        } catch (err) {
            alert('Erro de conexão ao excluir usuário.');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Confirmar Exclusão';
            fecharConfirmarExclusao();
        }
    }

    // Sincroniza estilo ativo dos chips dinamicamente
    document.addEventListener('change', function(e) {
        if (e.target.matches('.tag-check-chip input[type="checkbox"]')) {
            const label = e.target.closest('.tag-check-chip');
            if (label) {
                if (e.target.checked) label.classList.add('ativo');
                else label.classList.remove('ativo');
            }
        }
    });

    // Modal Histórico
    async function abrirHistoricoAluno(id, nome) {
        document.getElementById('modalHistoricoTitulo').textContent = 'Histórico: ' + nome;
        document.getElementById('corpoHistoricoModal').innerHTML = '<p style="text-align:center; padding:20px; color:var(--text-muted);">Buscando histórico...</p>';
        document.getElementById('modalHistoricoAluno').classList.remove('oculto');

        try {
            const token = localStorage.getItem('authToken');
            const resp = await fetch(`/paginas/usuarios/aluno/${id}/historico`, {
                headers: token ? { Authorization: 'Bearer ' + token } : {}
            });
            const res = await resp.json();

            if (res.sucesso && res.dados) {
                const al = res.dados.aluno;
                document.getElementById('modalHistoricoSubtitulo').textContent = `Curso: ${al.curso || 'Piano'} • Desconto: ${al.desconto_porcentagem || 0}%`;

                const mens = res.dados.mensalidades;
                if (mens.length === 0) {
                    document.getElementById('corpoHistoricoModal').innerHTML = '<p style="text-align:center; padding:20px; color:var(--text-muted);">Nenhuma mensalidade registrada para este aluno.</p>';
                    return;
                }

                let html = `
                    <table class="tabela-mensalidades" style="font-size:12.5px;">
                        <thead>
                            <tr>
                                <th>Mês / Ref</th>
                                <th>Vencimento</th>
                                <th>Valor</th>
                                <th>Status</th>
                                <th>Pago em</th>
                                <th>Anexo</th>
                            </tr>
                        </thead>
                        <tbody>
                `;

                mens.forEach(m => {
                    const statusClass = m.status_parcela === 'pago' ? 'pago' : (m.status_parcela === 'em_analise' ? 'em_analise' : (m.status_parcela === 'atrasado' ? 'atrasado' : 'pendente'));
                    const statusLabel = m.status_parcela === 'pago' ? 'Pago' : (m.status_parcela === 'em_analise' ? 'Em Análise' : (m.status_parcela === 'atrasado' ? 'Vencido' : 'Pendente'));
                    const venc = m.data_vencimento ? new Date(m.data_vencimento).toLocaleDateString('pt-BR') : '—';
                    const pag = m.data_pagamento ? new Date(m.data_pagamento).toLocaleDateString('pt-BR') : '—';
                    const anexo = m.comprovante_url ? `<a href="${m.comprovante_url}" target="_blank" class="link-ver-comprovante">Ver</a>` : '<span style="color:#94a3b8;">—</span>';

                    html += `
                        <tr>
                            <td><strong>${m.mes_referencia || 'Geral'}</strong></td>
                            <td>${venc}</td>
                            <td><strong>R$ ${Number(m.valor).toFixed(2)}</strong></td>
                            <td><span class="status-pill ${statusClass}">${statusLabel}</span></td>
                            <td>${pag}</td>
                            <td>${anexo}</td>
                        </tr>
                    `;
                });

                html += '</tbody></table>';
                document.getElementById('corpoHistoricoModal').innerHTML = html;
            }
        } catch (err) {
            document.getElementById('corpoHistoricoModal').innerHTML = '<p style="text-align:center; color:#dc2626; padding:20px;">Erro ao carregar histórico.</p>';
        }
    }

    function fecharModalHistorico() {
        document.getElementById('modalHistoricoAluno').classList.add('oculto');
    }

    // Modal Validação de Comprovante
    let idRecebimentoValidando = null;

    function abrirModalValidacao(id, nome, valor, anexoUrl) {
        idRecebimentoValidando = id;
        document.getElementById('valNomeAluno').textContent = nome;
        document.getElementById('valValorAluno').textContent = 'R$ ' + valor;
        const link = document.getElementById('valLinkComprovante');
        link.href = anexoUrl || '#';
        document.getElementById('modalValidacaoComprovante').classList.remove('oculto');
    }

    function fecharModalValidacao() {
        document.getElementById('modalValidacaoComprovante').classList.add('oculto');
        idRecebimentoValidando = null;
    }

    async function confirmarComprovanteAtual() {
        if (!idRecebimentoValidando) return;
        const btn = document.getElementById('btnConfirmarValidacao');
        btn.disabled = true;
        btn.textContent = 'Validando pagamento...';

        try {
            const token = localStorage.getItem('authToken');
            const resp = await fetch('/paginas/dashboard/confirmar-comprovante', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    ...(token ? { Authorization: 'Bearer ' + token } : {})
                },
                body: JSON.stringify({ idRecebimento: idRecebimentoValidando }),
            });
            const dados = await resp.json();

            if (dados.sucesso) {
                alert('✓ ' + dados.mensagem);
                window.location.reload();
            } else {
                alert('Erro: ' + (dados.mensagem || 'Falha ao validar comprovante.'));
            }
        } catch (err) {
            alert('Erro de conexão ao validar comprovante.');
        } finally {
            btn.disabled = false;
            btn.textContent = '✓ Confirmar Pagamento e Validar Mensalidade';
        }
    }
</script>

