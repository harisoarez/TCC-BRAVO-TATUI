<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="conteudo">
    <h1><%= titulo %></h1>

    <form id="form-aula" class="formulario">
        <div class="campo">
            <label for="titulo">Título / Identificador da Aula</label>
            <input type="text" id="titulo" name="titulo" placeholder="Ex: Aula de Violino - Individual" required>
        </div>

        <div class="campo">
            <label for="instrumento">Instrumento</label>
            <input type="text" id="instrumento" name="instrumento" placeholder="Ex: Violino, Piano, Canto..." required>
        </div>

        <div class="campo">
            <label for="professor_idprofessor">Professor Responsável</label>
            <select id="professor_idprofessor" name="professor_idprofessor" required>
                <option value="">Selecione um professor</option>
                <% professores.forEach(function(prof) { %>
                    <option value="<%= prof.idprofessor %>"><%= prof.nome %> (<%= prof.tipo_instrumento || 'Geral' %>)</option>
                <% }); %>
            </select>
        </div>

        <div class="campo">
            <label for="aluno_idaluno">Aluno (opcional)</label>
            <select id="aluno_idaluno" name="aluno_idaluno">
                <option value="">Nenhum aluno vinculado / Aula em Grupo</option>
                <% alunos.forEach(function(aluno) { %>
                    <option value="<%= aluno.idaluno %>"><%= aluno.nome %></option>
                <% }); %>
            </select>
        </div>

        <div class="campo">
            <label for="sala">Sala de Aula</label>
            <select id="sala" name="sala" required>
                <% salas.forEach(function(s) { %>
                    <option value="<%= typeof s === 'object' ? s.id : s %>"><%= typeof s === 'object' ? s.nome : (s === 5 ? 'Sala de Bateria' : 'Sala ' + s) %></option>
                <% }); %>
            </select>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="campo">
                <label for="data">Data</label>
                <input type="date" id="data" name="data" required>
            </div>
            <div class="campo">
                <label for="hora">Horário (HH:MM)</label>
                <input type="time" id="hora" name="hora" required>
            </div>
        </div>

        <div class="campo">
            <label for="tipo">Status / Tipo de Aula</label>
            <select id="tipo" name="tipo">
                <option value="normal">Normal (Regular)</option>
                <option value="reposicao">Reposição</option>
                <option value="cancelada">Cancelada</option>
            </select>
        </div>

        <div class="campo">
            <label for="duracao_minutos">Duração (minutos)</label>
            <input type="number" id="duracao_minutos" name="duracao_minutos" value="60" min="15" step="15">
        </div>

        <div class="campo">
            <label for="observacoes">Observações Internas</label>
            <textarea id="observacoes" name="observacoes" rows="3" placeholder="Informações pedagógicas ou observações da aula..."></textarea>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
            <button type="submit" class="botao">Salvar Agendamento</button>
            <a href="/paginas/aulas" class="botao botao-secundario">Cancelar</a>
        </div>
    </form>
</main>

<script>
    document.getElementById("form-aula").addEventListener("submit", async function(e) {
        e.preventDefault();

        const formData = new FormData(this);
        const corpo = Object.fromEntries(formData.entries());

        const resposta = await fetch("/api/aulas", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
            },
            body: JSON.stringify(corpo),
        });

        const dados = await resposta.json();

        if (dados.sucesso) {
            window.location.href = "/paginas/aulas";
        } else {
            alert(dados.mensagem || "Erro ao salvar agendamento.");
        }
    });
</script>

<%- include('../partials/footer') %>
